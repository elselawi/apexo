<?xml version="1.0" encoding="utf-8"?>
<!--
  Native packages for the Windows runner.

  These are the versions the official Windows App SDK 1.7 C++ push sample pins
  (WindowsAppSDK-Samples, release/1.7-stable, Samples/Notifications/Push).
  Restore with windows/restore_windows_packages.ps1; the runner CMake project
  reads them from windows/packages.
-->
<packages>
  <package id="Microsoft.Windows.CppWinRT" version="2.0.221104.6" targetFramework="native" />
  <package id="Microsoft.Windows.ImplementationLibrary" version="1.0.220914.1" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.BuildTools" version="10.0.22621.3233" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK" version="1.7.250513003" targetFramework="native" />
</packages>
